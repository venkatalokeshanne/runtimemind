# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
# 
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!
#
# ============================================================================

# SUPABASE CONFIGURATION
# ----------------------
# Get these from your Supabase project dashboard:
# Project Settings → API
#
# NEXT_PUBLIC_ prefix exposes to browser (safe because RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret (DO NOT COMMIT, only set on your deployment/CI)
# Use this on server-side code only (API routes, server functions). Never expose in browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SITE CONFIGURATION
# ------------------
# Base URL for sitemap generation and absolute URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# OPTIONAL: Analytics
# -------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
